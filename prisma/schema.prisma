generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  ACCOUNTANT
  CASHIER
  CHEF
  STOREKEEPER
  PURCHASER
  HR
  PARENT
  ELEVE
  EMPLOYE
}

model User {
  codeAcces CodeAcces?
  imageId      String?
  image        Image?   @relation(fields: [imageId], references: [id], onDelete: SetNull)
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(MANAGER)
  active       Boolean  @default(true)
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  totpSecret    String?
  totpEnabled   Boolean  @default(false)
  totpLastStep  Int?
  recoveryCodes String[] @default([])

  etablissements UserEtablissement[]

  @@map("users")
}

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String?
  userEmail String?
  action    String
  entity    String?
  entityId  String?
  details   String?
  ip        String?

  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

enum EtablissementType {
  SCHOOL
  COMPANY
  OTHER
}

model Etablissement {
  commandesMobile CommandeMobile[]
  cartesCadeaux CarteCadeau[]
  categoriesArticles CategorieArticle[]
  codesAcces CodeAcces[]
  sessionsCaisse           SessionCaisse[]
  images                   Image[]
  logoId                   String?
  logo                     Image?              @relation("EtabLogo", fields: [logoId], references: [id], onDelete: SetNull)
  sessionCaisseObligatoire Boolean             @default(false)
  id                       String              @id @default(cuid())
  code                     String              @unique
  name                     String
  type                     EtablissementType   @default(SCHOOL)
  address                  String?
  phone                    String?
  email                    String?
  currency                 String              @default("XOF")
  prepaye                  Boolean             @default(false)
  active                   Boolean             @default(true)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  users                    UserEtablissement[]

  referentiels Referentiel[]
  inscrits     Inscrit[]
  ingredients  Ingredient[]
  plats        Plat[]
  menus        Menu[]
  reservations Reservation[]

  tarifs           Tarif[]
  paiementsEnLigne PaiementEnLigne[]
  transactions     Transaction[]

  clients    Client[]
  factures   Facture[]
  reglements Reglement[]

  fournisseurs           Fournisseur[]
  bonsCommande           BonCommande[]
  lots                   Lot[]
  mouvementsStock        MouvementStock[]
  consommations          Consommation[]
  parametresNotification ParametresNotification?
  notifications          Notification[]
  ecrituresCompta        EcritureCompta[]
  cloturesCompta         ClotureCompta[]
  employesRh             EmployeRh[]
  parametresPaie         ParametresPaie?
  bulletinsPaie          BulletinPaie[]
  evenementsCantine      EvenementCantine[]
  plansProduction        PlanProduction[]
  gaspillages            Gaspillage[]
  articlesCarte          ArticleCarte[]
  ventesComptoir         VenteComptoir[]

  aides             Aide[]
  aidesInscrits     AideInscrit[]
  conges            Conge[]
  pointages         Pointage[]
  certifications    Certification[]
  avisListe         Avis[]
  suggestions       Suggestion[]
  equipements       Equipement[]
  releves           ReleveTemperature[]
  tachesHygiene     TacheHygiene[]
  executionsHygiene ExecutionHygiene[]
  nonConformites    NonConformite[]
  echantillons      EchantillonTemoin[]
  objectifs         ObjectifKpi[]
  clesApi           CleApi[]
  reglesReappro     RegleReappro[]
  transfertsEnvoyes Transfert[]         @relation("TransfertSource")
  transfertsRecus   Transfert[]         @relation("TransfertDest")

  @@map("etablissements")
}

model UserEtablissement {
  userId          String
  etablissementId String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@id([userId, etablissementId])
  @@index([etablissementId])
  @@map("user_etablissements")
}

enum ReferentielKind {
  GROUPE
  REGIME
  ALLERGIE
}

enum InscritType {
  STUDENT
  EMPLOYEE
  GUEST
}

enum InscritStatut {
  ACTIVE
  SUSPENDED
  LEFT
}

model Referentiel {
  id              String            @id @default(cuid())
  etablissementId String
  etablissement   Etablissement     @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  kind            ReferentielKind
  name            String
  createdAt       DateTime          @default(now())
  groupeInscrits  Inscrit[]         @relation("InscritGroupe")
  regimeInscrits  Inscrit[]         @relation("InscritRegime")
  allergies       InscritAllergie[]

  ingredientAllergens IngredientAllergen[]

  @@unique([etablissementId, kind, name])
  @@map("referentiels")
}

model Inscrit {
  codeAcces CodeAcces?
  id              String            @id @default(cuid())
  etablissementId String
  etablissement   Etablissement     @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  matricule       String
  firstName       String
  lastName        String
  type            InscritType       @default(STUDENT)
  statut          InscritStatut     @default(ACTIVE)
  groupeId        String?
  groupe          Referentiel?      @relation("InscritGroupe", fields: [groupeId], references: [id], onDelete: SetNull)
  regimeId        String?
  regime          Referentiel?      @relation("InscritRegime", fields: [regimeId], references: [id], onDelete: SetNull)
  badge           String            @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  allergies       InscritAllergie[]
  tuteurs         Tuteur[]
  reservations    Reservation[]

  solde            Int               @default(0)
  transactions     Transaction[]
  paiementsEnLigne PaiementEnLigne[]

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  aidesInscrit AideInscrit[]

  imageId String?
  image   Image?  @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@unique([etablissementId, matricule])
  @@index([clientId])
  @@index([etablissementId, lastName])
  @@map("inscrits")
}

model InscritAllergie {
  inscritId  String
  allergieId String
  inscrit    Inscrit     @relation(fields: [inscritId], references: [id], onDelete: Cascade)
  allergie   Referentiel @relation(fields: [allergieId], references: [id], onDelete: Cascade)

  @@id([inscritId, allergieId])
  @@map("inscrit_allergies")
}

model Tuteur {
  id        String   @id @default(cuid())
  inscritId String
  inscrit   Inscrit  @relation(fields: [inscritId], references: [id], onDelete: Cascade)
  name      String
  relation  String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())

  @@index([inscritId])
  @@map("tuteurs")
}

enum MenuService {
  BREAKFAST
  LUNCH
  SNACK
  DINNER
}

enum MenuStatut {
  DRAFT
  PUBLISHED
}

model Ingredient {
  id              String               @id @default(cuid())
  etablissementId String
  etablissement   Etablissement        @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  name            String
  unit            String
  unitCost        Decimal              @default(0) @db.Decimal(14, 4)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  allergens       IngredientAllergen[]
  lignes          PlatIngredient[]
  stock           Decimal              @default(0) @db.Decimal(14, 3)
  seuil           Decimal              @default(0) @db.Decimal(14, 3)
  lots            Lot[]
  mouvementsStock MouvementStock[]
  lignesAchat     BonCommandeLigne[]

  nutrition     NutritionIngredient?
  reglesReappro RegleReappro[]

  @@unique([etablissementId, name])
  @@map("ingredients")
}

model IngredientAllergen {
  ingredientId String
  allergieId   String
  ingredient   Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  allergie     Referentiel @relation(fields: [allergieId], references: [id], onDelete: Cascade)

  @@id([ingredientId, allergieId])
  @@map("ingredient_allergens")
}

model Plat {
  imageId         String?
  image           Image?           @relation(fields: [imageId], references: [id], onDelete: SetNull)
  id              String           @id @default(cuid())
  etablissementId String
  etablissement   Etablissement    @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  portions        Int              @default(1)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  ingredients     PlatIngredient[]
  menus           MenuPlat[]

  @@unique([etablissementId, name])
  @@map("plats")
}

model PlatIngredient {
  platId       String
  ingredientId String
  quantity     Decimal    @db.Decimal(12, 3)
  plat         Plat       @relation(fields: [platId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([platId, ingredientId])
  @@index([ingredientId])
  @@map("plat_ingredients")
}

model Menu {
  imageId String?
  image   Image?  @relation(fields: [imageId], references: [id], onDelete: SetNull)
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  date            DateTime      @db.Date
  service         MenuService
  statut          MenuStatut    @default(DRAFT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  plats           MenuPlat[]

  @@unique([etablissementId, date, service])
  @@index([etablissementId, date])
  @@map("menus")
}

model MenuPlat {
  menuId String
  platId String
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  plat   Plat   @relation(fields: [platId], references: [id], onDelete: Cascade)

  @@id([menuId, platId])
  @@index([platId])
  @@map("menu_plats")
}

enum ReservationStatut {
  BOOKED
  CANCELLED
}

model Reservation {
  id              String            @id @default(cuid())
  etablissementId String
  etablissement   Etablissement     @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  inscritId       String
  inscrit         Inscrit           @relation(fields: [inscritId], references: [id], onDelete: Cascade)
  date            DateTime          @db.Date
  service         MenuService
  statut          ReservationStatut @default(BOOKED)
  servedAt        DateTime?
  walkIn          Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  factureId String?
  facture   Facture? @relation(fields: [factureId], references: [id], onDelete: SetNull)

  @@unique([inscritId, date, service])
  @@index([factureId])
  @@index([etablissementId, date, service])
  @@map("reservations")
}

enum MethodePaiement {
  CASH
  ORANGE
  MTN
  WAVE
  MOOV
  PAYSTACK
}

enum StatutPaiementEnLigne {
  PENDING
  SUCCESS
  FAILED
}

enum TransactionType {
  TOPUP
  DEBIT
  REFUND
  ADJUST
}

model Tarif {
  etablissementId String
  service         MenuService
  prix            Int           @default(0)
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  @@id([etablissementId, service])
  @@map("tarifs")
}

model Transaction {
  id              String           @id @default(cuid())
  etablissementId String
  etablissement   Etablissement    @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  inscritId       String
  inscrit         Inscrit          @relation(fields: [inscritId], references: [id], onDelete: Cascade)
  type            TransactionType
  methode         MethodePaiement?
  montant         Int
  reference       String?
  reservationId   String?
  note            String?
  createdBy       String?
  createdAt       DateTime         @default(now())

  @@unique([etablissementId, reference])
  @@index([inscritId, createdAt])
  @@index([etablissementId, createdAt])
  @@map("transactions")
}

model PaiementEnLigne {
  id              String                @id @default(cuid())
  etablissementId String
  etablissement   Etablissement         @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  inscritId       String
  inscrit         Inscrit               @relation(fields: [inscritId], references: [id], onDelete: Cascade)
  userId          String?
  userEmail       String
  reference       String                @unique
  montant         Int
  statut          StatutPaiementEnLigne @default(PENDING)
  canal           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  creditedAt      DateTime?

  @@index([inscritId, createdAt])
  @@index([etablissementId, createdAt])
  @@map("paiements_en_ligne")
}

enum StatutFacture {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

model Client {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  name            String
  email           String?
  phone           String?
  address         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  inscrits        Inscrit[]
  factures        Facture[]

  @@unique([etablissementId, name])
  @@map("clients")
}

model Facture {
  id              String         @id @default(cuid())
  etablissementId String
  etablissement   Etablissement  @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  numero          Int?
  periode         String
  statut          StatutFacture  @default(DRAFT)
  total           Int
  emisLe          DateTime?
  echeance        DateTime?      @db.Date
  createdBy       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  lignes          FactureLigne[]
  reglements      Reglement[]
  relances        Relance[]
  reservations    Reservation[]

  @@unique([etablissementId, numero])
  @@index([etablissementId, statut])
  @@index([clientId])
  @@map("factures")
}

model FactureLigne {
  id           String  @id @default(cuid())
  factureId    String
  facture      Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)
  libelle      String
  quantite     Int
  prixUnitaire Int
  montant      Int

  @@index([factureId])
  @@map("facture_lignes")
}

model Reglement {
  id              String          @id @default(cuid())
  etablissementId String
  etablissement   Etablissement   @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  factureId       String
  facture         Facture         @relation(fields: [factureId], references: [id], onDelete: Cascade)
  montant         Int
  methode         MethodePaiement
  reference       String?
  createdBy       String?
  createdAt       DateTime        @default(now())

  @@unique([etablissementId, reference])
  @@index([factureId])
  @@map("reglements")
}

model Relance {
  id        String   @id @default(cuid())
  factureId String
  facture   Facture  @relation(fields: [factureId], references: [id], onDelete: Cascade)
  niveau    Int
  note      String?
  createdBy String?
  createdAt DateTime @default(now())

  @@unique([factureId, niveau])
  @@map("relances")
}

enum TypeMouvement {
  ENTREE
  SORTIE
  PERTE
  INVENTAIRE
}

enum StatutBon {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}

model Fournisseur {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  name            String
  email           String?
  phone           String?
  address         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  bons            BonCommande[]

  @@unique([etablissementId, name])
  @@map("fournisseurs")
}

model BonCommande {
  id              String             @id @default(cuid())
  etablissementId String
  etablissement   Etablissement      @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  fournisseurId   String
  fournisseur     Fournisseur        @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)
  numero          Int?
  statut          StatutBon          @default(DRAFT)
  note            String?
  envoyeLe        DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  lignes          BonCommandeLigne[]

  @@unique([etablissementId, numero])
  @@index([etablissementId, statut])
  @@index([fournisseurId])
  @@map("bons_commande")
}

model BonCommandeLigne {
  id           String      @id @default(cuid())
  bonId        String
  bon          BonCommande @relation(fields: [bonId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantite     Decimal     @db.Decimal(14, 3)
  prix         Decimal     @default(0) @db.Decimal(14, 4)
  recue        Decimal     @default(0) @db.Decimal(14, 3)

  @@unique([bonId, ingredientId])
  @@index([ingredientId])
  @@map("bon_commande_lignes")
}

model Lot {
  id              String           @id @default(cuid())
  etablissementId String
  etablissement   Etablissement    @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  ingredientId    String
  ingredient      Ingredient       @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  reference       String
  quantite        Decimal          @db.Decimal(14, 3)
  restante        Decimal          @db.Decimal(14, 3)
  prix            Decimal          @default(0) @db.Decimal(14, 4)
  peremption      DateTime?        @db.Date
  recuLe          DateTime         @default(now())
  bonId           String?
  mouvements      MouvementStock[]

  @@index([ingredientId, restante])
  @@index([etablissementId])
  @@map("lots")
}

model MouvementStock {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  ingredientId    String
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  lotId           String?
  lot             Lot?          @relation(fields: [lotId], references: [id], onDelete: SetNull)
  type            TypeMouvement
  quantite        Decimal       @db.Decimal(14, 3)
  prix            Decimal?      @db.Decimal(14, 4)
  reference       String?
  note            String?
  bonId           String?
  consommationId  String?
  userEmail       String?
  createdAt       DateTime      @default(now())

  @@index([ingredientId, createdAt])
  @@index([etablissementId, createdAt])
  @@map("mouvements_stock")
}

model Consommation {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  date            DateTime      @db.Date
  service         MenuService
  repas           Int
  userEmail       String?
  createdAt       DateTime      @default(now())

  @@unique([etablissementId, date, service])
  @@map("consommations")
}

enum CanalNotification {
  SMS
  WHATSAPP
  EMAIL
}

enum StatutNotification {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model ParametresNotification {
  etablissementId String        @id
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  sms             Boolean       @default(false)
  whatsapp        Boolean       @default(false)
  email           Boolean       @default(true)
  relances        Boolean       @default(true)
  recharges       Boolean       @default(true)
  soldeBas        Boolean       @default(true)
  seuilSoldeBas   Int           @default(1000)
  repasServi      Boolean       @default(false)
  alertesStock    Boolean       @default(true)

  @@map("parametres_notification")
}

model Notification {
  id              String             @id @default(cuid())
  etablissementId String
  etablissement   Etablissement      @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  canal           CanalNotification
  destinataire    String
  sujet           String?
  message         String
  evenement       String
  cle             String
  statut          StatutNotification @default(PENDING)
  tentatives      Int                @default(0)
  erreur          String?
  createdAt       DateTime           @default(now())
  envoyeLe        DateTime?

  @@unique([etablissementId, cle])
  @@index([etablissementId, createdAt])
  @@index([statut])
  @@map("notifications")
}

model Configuration {
  cle       String   @id
  valeur    String
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("configuration")
}

enum JournalCompta {
  VE
  AC
  CA
  BQ
  OD
}

// Ecriture comptable immuable : on ne la modifie jamais, on la contrepasse.
// (etablissementId, sourceType, sourceId) rend la comptabilisation d'une piece source idempotente.
model EcritureCompta {
  id              String          @id @default(cuid())
  etablissementId String
  etablissement   Etablissement   @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  numero          Int
  journal         JournalCompta
  date            DateTime        @db.Date
  piece           String?
  libelle         String
  sourceType      String?
  sourceId        String?
  createdBy       String?
  createdAt       DateTime        @default(now())
  lignes          EcritureLigne[]

  @@unique([etablissementId, numero])
  @@unique([etablissementId, sourceType, sourceId])
  @@index([etablissementId, date])
  @@map("ecritures_compta")
}

model EcritureLigne {
  id         String         @id @default(cuid())
  ecritureId String
  ecriture   EcritureCompta @relation(fields: [ecritureId], references: [id], onDelete: Cascade)
  compte     String
  debit      Int            @default(0)
  credit     Int            @default(0)

  @@index([ecritureId])
  @@index([compte])
  @@map("ecriture_lignes")
}

model ClotureCompta {
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  periode         String
  clotureLe       DateTime      @default(now())
  clotureePar     String?

  @@id([etablissementId, periode])
  @@map("clotures_compta")
}

enum SituationFamiliale {
  CELIBATAIRE
  MARIE
  DIVORCE
  VEUF
}

enum StatutBulletin {
  DRAFT
  VALIDATED
}

model EmployeRh {
  codeAcces CodeAcces?
  id                String             @id @default(cuid())
  etablissementId   String
  etablissement     Etablissement      @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  matricule         String
  firstName         String
  lastName          String
  poste             String?
  dateEmbauche      DateTime           @db.Date
  salaireBase       Int
  primes            Int                @default(0)
  indemniteExoneree Int                @default(0)
  situation         SituationFamiliale @default(CELIBATAIRE)
