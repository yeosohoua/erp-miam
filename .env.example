# Copiez ce fichier en .env puis remplacez TOUTES les valeurs. Ne publiez jamais le vrai .env.

# Base PostgreSQL (docker compose)
POSTGRES_USER=miam
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=miam
# Pour lancer l'app hors Docker (npm run dev) : la base est exposee sur le port 5433
DATABASE_URL=postgresql://miam:changez-moi@localhost:5433/miam

# Redis
REDIS_PASSWORD=changez-moi
REDIS_URL=redis://:changez-moi@localhost:6380

# Secret de session (chaine aleatoire d'au moins 32 caracteres)
SESSION_SECRET=remplacez-par-une-longue-chaine-aleatoire

# Compte administrateur cree par le seed
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changez-moi

# Adresse publique de l'ERP (page de retour Paystack, liens)
APP_URL=http://localhost:3001

# Paystack (cles de TEST sk_test_ / pk_test_ en developpement)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Adresse e-mail utilisee quand un compte n'a pas d'e-mail reel (facultatif)
PAYSTACK_EMAIL_DEFAUT=

# Taches planifiees (facultatif)
CRON_SECRET=

# Notifications (facultatif)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_LANG=
